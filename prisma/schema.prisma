generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  profile        UserProfile?
  contentPillars ContentPillar[]
  topics         Topic[]
  posts          Post[]
  youtubeChannels YouTubeChannel[]
  preferences    UserPreference[]
  feedbacks      ContentFeedback[]
  linkedinConnection LinkedInConnection?
  aiInteractions AIInteraction[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  name                String   @default("")
  headline            String   @default("")
  bio                 String   @default("")
  currentRole         String   @default("")
  previousRoles       Json     @default("[]")
  skills              Json     @default("[]")
  industries          Json     @default("[]")
  topicsOfInterest    Json     @default("[]")
  topicsToAvoid       Json     @default("[]")
  contentGoals        String   @default("")
  writingStyle        String   @default("insightful")
  targetAudience      String   @default("")
  linkedinProfileUrl  String   @default("")
  postingFrequency    String   @default("daily")
  preferredPostTimes  Json     @default("[]")
  geoRelevance        String   @default("")
  preferredLanguages  Json     @default("[\"en\"]")
  contentPillars      Json     @default("[]")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LinkedInConnection {
  id              String   @id @default(cuid())
  userId          String   @unique
  accessToken     String
  refreshToken    String?
  expiresAt       DateTime
  refreshExpiresAt DateTime?
  memberUrn       String?
  memberName      String?
  memberImage     String?
  scopes          String?
  connected       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ContentPillar {
  id              String   @id @default(cuid())
  userId          String
  name            String
  description     String   @default("")
  priority        Int      @default(0)
  enabled         Boolean  @default(true)
  keywords        Json     @default("[]")
  excludedKeywords Json    @default("[]")
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  topics Topic[]

  @@index([userId])
}

model Topic {
  id              String   @id @default(cuid())
  userId          String
  canonicalTitle  String
  summary         String
  whyTrending     String   @default("")
  whyMatters      String   @default("")
  whyRelevant     String   @default("")
  category        String   @default("")
  freshnessScore  Float    @default(0)
  relevanceScore  Float    @default(0)
  trendScore      Float    @default(0)
  overallScore    Float    @default(0)
  postPotential   String   @default("MEDIUM")
  analysis        Json?
  suggestedAngles Json     @default("[]")
  dismissed       Boolean  @default(false)
  discoveredAt    DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  userId2        String?
  pillarId       String?

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  pillar  ContentPillar? @relation(fields: [pillarId], references: [id])
  sources TopicSource[]
  posts   Post[]

  @@index([userId, overallScore])
  @@index([userId, discoveredAt])
}

model TopicSource {
  id           String   @id @default(cuid())
  topicId      String
  title        String
  url          String
  publisher    String   @default("")
  publishedAt  DateTime?
  sourceType   String   @default("article")
  tier         Int      @default(3)
  credibility  String   @default("unknown")
  snippet      String   @default("")
  createdAt    DateTime @default(now())

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
}

model YouTubeChannel {
  id          String   @id @default(cuid())
  userId      String
  channelId   String
  name        String   @default("")
  description String   @default("")
  thumbnail   String   @default("")
  uploadsPlaylistId String @default("")
  enabled     Boolean  @default(true)
  lastSyncAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  videos YouTubeVideo[]

  @@unique([userId, channelId])
}

model YouTubeVideo {
  id           String   @id @default(cuid())
  channelId    String
  videoId      String   @unique
  title        String
  description  String   @default("")
  url          String
  publishedAt  DateTime
  thumbnail    String   @default("")
  processed    Boolean  @default(false)
  retrievedAt  DateTime @default(now())
  createdAt    DateTime @default(now())

  channel  YouTubeChannel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  insights YouTubeInsight[]

  @@index([channelId])
}

model YouTubeInsight {
  id           String   @id @default(cuid())
  videoId      String
  keyIdeas     Json     @default("[]")
  claims       Json     @default("[]")
  insights     Json     @default("[]")
  implications Json     @default("[]")
  topicsDiscussed Json  @default("[]")
  linkedinAngles  Json  @default("[]")
  summary      String   @default("")
  createdAt    DateTime @default(now())

  video YouTubeVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId])
}

model Post {
  id                 String   @id @default(cuid())
  userId             String
  topicId            String?
  content            String
  status             String   @default("DRAFT")
  tone               String   @default("insightful")
  length             String   @default("medium")
  angle              String   @default("")
  hashtags           Json     @default("[]")
  generationNumber   Int      @default(1)
  approvedTextHash   String?
  approvedImageHash  String?
  textApprovedAt     DateTime?
  imageApprovedAt    DateTime?
  publishedAt        DateTime?
  scheduledAt        DateTime?
  scheduledTimezone  String?
  linkedinPostId     String?
  linkedinPostUrn    String?
  factCheckResult    Json?
  sourceMetadata     Json     @default("[]")
  rejectionReason    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic    Topic?         @relation(fields: [topicId], references: [id])
  versions PostVersion[]
  images   GeneratedImage[]
  publishAttempts PublishAttempt[]

  @@index([userId, status])
  @@index([userId, scheduledAt])
}

model PostVersion {
  id        String   @id @default(cuid())
  postId    String
  content   String
  version   Int
  tone      String   @default("")
  angle     String   @default("")
  prompt    String   @default("")
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model GeneratedImage {
  id          String   @id @default(cuid())
  postId      String
  prompt      String
  filePath    String
  mimeType    String   @default("image/png")
  style       String   @default("")
  version     Int      @default(1)
  approved    Boolean  @default(false)
  active      Boolean  @default(true)
  imageHash   String?
  createdAt   DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model PublishAttempt {
  id              String   @id @default(cuid())
  postId          String
  idempotencyKey  String   @unique
  status          String   @default("PENDING")
  linkedinPostId  String?
  errorMessage    String?
  attemptedAt     DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model ScheduledJob {
  id          String   @id @default(cuid())
  postId      String   @unique
  executeAt   DateTime
  status      String   @default("PENDING")
  attempts    Int      @default(0)
  lastError   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([executeAt, status])
}

model AIInteraction {
  id            String   @id @default(cuid())
  userId        String
  operationType String
  model         String
  inputTokens   Int?
  outputTokens  Int?
  estimatedCost Float?
  durationMs    Int?
  metadata      Json?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model UserPreference {
  id        String   @id @default(cuid())
  userId    String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model ContentFeedback {
  id        String   @id @default(cuid())
  userId    String
  postId    String?
  type      String
  reason    String
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AnalyticsSnapshot {
  id          String   @id @default(cuid())
  postId      String
  impressions Int      @default(0)
  reactions   Int      @default(0)
  comments    Int      @default(0)
  reposts     Int      @default(0)
  engagementRate Float @default(0)
  fetchedAt   DateTime @default(now())

  @@index([postId])
}
