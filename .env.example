# Database — use Neon, Supabase, or Vercel Postgres for production
DATABASE_URL=postgresql://user:password@localhost:5432/linkedin_automation

# NextAuth
NEXTAUTH_SECRET=generate-a-random-secret-here
NEXTAUTH_URL=http://localhost:3000

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/linkedin/callback

# Google Gemini
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.0-flash-preview-image-generation

# YouTube Data API
YOUTUBE_API_KEY=

# Vercel Blob (for image storage in production)
BLOB_READ_WRITE_TOKEN=

# Scheduler cron secret
CRON_SECRET=generate-a-random-secret-here

# App URL (set to your Vercel domain in production)
APP_URL=http://localhost:3000
